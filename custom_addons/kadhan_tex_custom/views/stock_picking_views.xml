<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_kadhan_tex_custom_size" model="ir.ui.view">
        <field name="name">stock.picking.form.kadhan.tex.custom.size</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list//field[@name='product_uom']" position="after">
                <field name="kadhan_size" string="Size" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
