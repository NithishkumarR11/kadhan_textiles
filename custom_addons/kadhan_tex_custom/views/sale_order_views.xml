<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_kadhan_tex_custom_size" model="ir.ui.view">
        <field name="name">sale.order.form.kadhan.tex.custom.size</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_id']" position="after">
                <field name="kadhan_size" string="Size" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
