<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_kadhan_tex_custom_reports" model="ir.ui.view">
        <field name="name">res.company.form.kadhan.tex.custom.reports</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Kadhan Reports">
                    <group>
                        <group>
                            <field name="report_contact_name"/>
                            <field name="kadhan_reference"/>
                        </group>
                        <group>
                            <field name="report_footer_note"/>
                            <field name="invoice_terms"/>
                            <field name="delivery_terms"/>
                        </group>
                    </group>
                    <group string="Invoice Bank Details">
                        <group>
                            <field name="kadhan_bank_name" placeholder="e.g. HDFC BANK, MANGALAM"/>
                            <field name="kadhan_bank_acc_number"/>
                            <field name="kadhan_bank_ifsc"/>
                            <field name="kadhan_bank_acc_holder"/>
                        </group>
                        <group>
                            <field name="kadhan_payment_qr" widget="image" options="{'size': [120, 120]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
