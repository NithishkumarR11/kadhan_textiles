<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Our invoice layout has no header (see report_invoice.xml, which switches to
         web.basic_layout), so the default A4 paperformat's large top margin/header
         spacing just leaves blank space at the top of the page. -->
    <record id="paperformat_kadhan_invoice" model="report.paperformat">
        <field name="name">A4 - Kadhan Invoice</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="paperformat_kadhan_invoice_new" model="report.paperformat">
        <field name="name">A4 - Kadhan Invoice New</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="kadhan_tex_custom.paperformat_kadhan_invoice"/>
    </record>

    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="kadhan_tex_custom.paperformat_kadhan_invoice"/>
    </record>

    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="paperformat_id" ref="kadhan_tex_custom.paperformat_kadhan_invoice"/>
    </record>
</odoo>
