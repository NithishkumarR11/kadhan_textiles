<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_invoice_new" model="ir.actions.report">
        <field name="name">Invoice new</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kadhan_tex_custom.report_invoice_new</field>
        <field name="report_file">kadhan_tex_custom.report_invoice_new</field>
        <field name="print_report_name">'Invoice - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="kadhan_tex_custom.paperformat_kadhan_invoice_new"/>
    </record>

    <template id="report_invoice_new_document">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="company" t-value="o.company_id"/>
            <t t-set="company_partner" t-value="company.partner_id"/>
            <t t-set="partner" t-value="o.partner_id"/>
            <t t-set="shipping" t-value="o.partner_shipping_id or partner"/>
            <t t-set="currency" t-value="o.currency_id"/>
            <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': currency}"/>
            <t t-set="lines"
               t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product').sorted('sequence')"/>
            <t t-set="hsn_rows" t-value="o._kadhan_hsn_summary()"/>
            <t t-set="has_igst" t-value="any(r['igst'] for r in hsn_rows)"/>
            <t t-set="total_qty" t-value="sum(lines.mapped('quantity'))"/>
            <t t-set="total_tax" t-value="sum(lines.mapped('price_total')) - sum(lines.mapped('price_subtotal'))"/>
            <t t-set="bank" t-value="o._kadhan_bank_details()"/>
            <t t-set="qr_code_url" t-value="o._kadhan_payment_qr_src()"/>

            <div class="page kinv">
                <style type="text/css">
                    .kinv { font-family: "Times New Roman", "Liberation Serif", Times, serif !important; font-size: 13px; color: #000; }
                    .kinv * { font-family: "Times New Roman", "Liberation Serif", Times, serif !important; }
                    /* wkhtmltopdf on Windows rounds letter positions and overlaps wide letters (m, w) */
                    .kinv, .kinv * { text-rendering: geometricPrecision; }
                    .kinv h2 { text-align: center; font-size: 17px; font-weight: 700; margin: 0 0 6px 0; }
                    .kinv table { width: 100%; border-collapse: collapse; }
                    .kinv td, .kinv th { border: 1px solid #808080; padding: 4px 6px; vertical-align: top; }
                    /* borderless inner tables; !important beats Odoo's report table styles */
                    .kinv table.nb, .kinv table.nb * { border: 0 none !important; }
                    .kinv .nb td { padding: 0; }
                    .kinv .b { font-weight: 700; }
                    .kinv .r { text-align: right; white-space: nowrap; }
                    .kinv .c { text-align: center; }
                    .kinv .company-name { font-size: 19px; font-weight: 700; margin-bottom: 4px; }
                    .kinv .small div { margin-bottom: 3px; }
                    .kinv .items th { font-weight: 700; }
                    .kinv .items td { border-top: none; border-bottom: 1px solid #808080; }
                    .kinv .items tr.filler td { border-bottom: none; }
                    .kinv .items tr.total td { border-top: 1px solid #808080; font-weight: 700; }
                    .kinv .muted { font-size: 12px; }
                    .kinv .inner td { border: none; padding: 3px 6px; }
                    .kinv .inner tr.line td { border-bottom: 1px solid #808080; }
                    .kinv .bank-lines div { margin-bottom: 8px; }
                    .kinv .upi { margin-top: 4px; font-size: 9px; white-space: nowrap; }
                    .kinv .upi i { font-weight: 700; color: #666; margin-right: 2px; }
                    .kinv .upi span { background-color: #3ecf8e; color: #fff; padding: 1px 4px; border-radius: 2px; }
                    .kinv .grid td { border-left: none; border-right: none; }
                    .kinv .no-top > tbody > tr:first-child > td,
                    .kinv .no-top > thead > tr:first-child > th { border-top: none; }
                </style>

                <h2>Tax Invoice</h2>

                <!-- Header: company / invoice meta -->
                <table>
                    <tr>
                        <td style="width: 50%;" rowspan="3" class="small">
                            <table class="nb">
                                <tr>
                                    <td t-if="company.kadhan_invoice_logo" style="width: 100px; padding-right: 10px; vertical-align: middle;">
                                        <img t-att-src="image_data_uri(company.kadhan_invoice_logo)" style="width: 96px; height: 96px; object-fit: contain;"/>
                                    </td>
                                    <td>
                                        <div class="company-name" t-out="company.name"/>
                                        <div>
                                            <t t-out="', '.join(p for p in [company_partner.street, company_partner.street2, company_partner.city] if p)"/>
                                            <t t-if="company_partner.zip"> - <t t-out="company_partner.zip"/></t>
                                        </div>
                                        <div t-if="company.vat">GSTIN: <t t-out="company.vat"/></div>
                                        <div t-if="company.phone">Phone: <t t-out="company.phone"/></div>
                                        <div t-if="company.state_id">State: <t t-out="o._kadhan_state_label(company.state_id)"/></div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td style="width: 25%;">
                            <div>Invoice No.</div>
                            <div class="b" t-out="o.name"/>
                        </td>
                        <td style="width: 25%;">
                            <div>Date</div>
                            <div class="b" t-out="o.invoice_date and o.invoice_date.strftime('%d-%m-%Y') or ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div>E-way Bill number</div>
                            <div class="b" t-out="o.kadhan_eway_bill_no or ''"/>
                        </td>
                        <td>
                            <div>Place of Supply</div>
                            <div class="b" t-out="o._kadhan_state_label(o.l10n_in_state_id or shipping.state_id)"/>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div>Vehicle Number</div>
                            <div class="b" t-out="o.kadhan_vehicle_no or ''"/>
                        </td>
                        <td/>
                    </tr>
                    <!-- Bill to / ship to -->
                    <tr>
                        <td class="small">
                            <div style="margin-bottom: 6px;">Bill To</div>
                            <div class="b" t-out="partner.commercial_partner_id.name or partner.name"/>
                            <div>
                                <t t-out="' '.join(p for p in [partner.street, partner.street2, partner.city] if p)"/>
                                <t t-if="partner.zip"> - <t t-out="partner.zip"/></t>
                            </div>
                            <div t-if="partner.vat">GSTIN Number: <t t-out="partner.vat"/></div>
                            <div t-if="partner.state_id">State: <t t-out="o._kadhan_state_label(partner.state_id)"/></div>
                        </td>
                        <td colspan="2" class="small">
                            <div class="b" style="margin-bottom: 6px;">Ship To</div>
                            <div t-field="o.kadhan_ship_to_address"/>
                        </td>
                    </tr>
                </table>

                <!-- Items -->
                <table class="items no-top">
                    <thead>
                        <tr>
                            <th style="width: 4%;">#</th>
                            <th style="width: 26%;">Item name</th>
                            <th style="width: 10%;">HSN/ SAC</th>
                            <th style="width: 11%;" class="r">Quantity</th>
                            <th style="width: 10%;" class="r">Unit</th>
                            <th style="width: 12%;" class="r">Price/ Unit</th>
                            <th style="width: 12%;" class="r">GST</th>
                            <th style="width: 15%;" class="r">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="line">
                            <t t-set="line_tax" t-value="line.price_total - line.price_subtotal"/>
                            <t t-set="line_rate" t-value="sum(o._kadhan_flat_taxes(line.tax_ids).filtered(lambda t: t.amount_type == 'percent').mapped('amount'))"/>
                            <td t-out="line_index + 1"/>
                            <td class="b" t-out="line.product_id.name or line.name"/>
                            <td t-out="o._kadhan_line_hsn(line)"/>
                            <td class="r" t-out="'%g' % line.quantity"/>
                            <td class="r" t-out="line.product_uom_id.name or ''"/>
                            <td class="r" t-out="line.price_unit" t-options="money"/>
                            <td class="r">
                                <div t-out="line_tax" t-options="money"/>
                                <div t-if="line_rate">(<t t-out="'%g' % line_rate"/>%)</div>
                            </td>
                            <td class="r" t-out="line.price_total" t-options="money"/>
                        </tr>
                        <!-- Blank filler so the table keeps the height of the reference layout -->
                        <tr t-if="len(lines) &lt; 8" class="filler">
                            <td t-att-style="'height: %dpx;' % ((8 - len(lines)) * 26)"/>
                            <td/><td/><td/><td/><td/><td/><td/>
                        </tr>
                        <tr class="total">
                            <td/>
                            <td>Total</td>
                            <td/>
                            <td class="r" t-out="'%g' % total_qty"/>
                            <td/>
                            <td/>
                            <td class="r" t-out="total_tax" t-options="money"/>
                            <td class="r" t-out="o.amount_total" t-options="money"/>
                        </tr>
                    </tbody>
                </table>

                <!-- Amount in words / amounts -->
                <table class="no-top">
                    <tr>
                        <td style="width: 50%;">
                            <div>Invoice Amount In Words</div>
                            <div class="b" style="margin-top: 6px;" t-out="o._kadhan_amount_in_words()"/>
                        </td>
                        <td style="width: 50%; padding: 0;">
                            <table class="inner">
                                <tr><td colspan="2" class="b">Amounts</td></tr>
                                <tr class="line">
                                    <td>Sub Total</td>
                                    <td class="r" t-out="o.amount_total" t-options="money"/>
                                </tr>
                                <tr class="b">
                                    <td>Total</td>
                                    <td class="r" t-out="o.amount_total" t-options="money"/>
                                </tr>
                                <tr class="line">
                                    <td>Received</td>
                                    <td class="r" t-out="o.amount_total - o.amount_residual" t-options="money"/>
                                </tr>
                                <tr>
                                    <td>Balance</td>
                                    <td class="r" t-out="o.amount_residual" t-options="money"/>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- HSN tax summary -->
                <table class="no-top">
                    <thead>
                        <tr>
                            <th rowspan="2" class="c" style="vertical-align: middle;">HSN/ SAC</th>
                            <th rowspan="2" class="c" style="vertical-align: middle;">Taxable amount</th>
                            <t t-if="has_igst">
                                <th colspan="2" class="c">IGST</th>
                            </t>
                            <t t-else="">
                                <th colspan="2" class="c">CGST</th>
                                <th colspan="2" class="c">SGST</th>
                            </t>
                            <th rowspan="2" class="c" style="vertical-align: middle;">Total Tax Amount</th>
                        </tr>
                        <tr>
                            <th class="c">Rate</th>
                            <th class="c">Amount</th>
                            <t t-if="not has_igst">
                                <th class="c">Rate</th>
                                <th class="c">Amount</th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="hsn_rows" t-as="row">
                            <td t-out="row['hsn']"/>
                            <td class="r" t-out="row['taxable']" t-options="money"/>
                            <t t-if="has_igst">
                                <td class="c"><t t-out="'%g' % row['igst_rate']"/>%</td>
                                <td class="r" t-out="row['igst']" t-options="money"/>
                            </t>
                            <t t-else="">
                                <td class="c"><t t-out="'%g' % row['cgst_rate']"/>%</td>
                                <td class="r" t-out="row['cgst']" t-options="money"/>
                                <td class="c"><t t-out="'%g' % row['sgst_rate']"/>%</td>
                                <td class="r" t-out="row['sgst']" t-options="money"/>
                            </t>
                            <td class="r" t-out="row['total_tax']" t-options="money"/>
                        </tr>
                        <tr class="b">
                            <td class="r">Total</td>
                            <td class="r" t-out="sum(r['taxable'] for r in hsn_rows)" t-options="money"/>
                            <t t-if="has_igst">
                                <td/>
                                <td class="r" t-out="sum(r['igst'] for r in hsn_rows)" t-options="money"/>
                            </t>
                            <t t-else="">
                                <td/>
                                <td class="r" t-out="sum(r['cgst'] for r in hsn_rows)" t-options="money"/>
                                <td/>
                                <td class="r" t-out="sum(r['sgst'] for r in hsn_rows)" t-options="money"/>
                            </t>
                            <td class="r" t-out="sum(r['total_tax'] for r in hsn_rows)" t-options="money"/>
                        </tr>
                    </tbody>
                </table>

                <!-- Bank / terms / signature -->
                <table class="no-top" style="page-break-inside: avoid;">
                    <tr>
                        <td style="width: 34%; height: 110px;">
                            <div class="b" style="margin-bottom: 6px;">Bank Details</div>
                            <table class="nb">
                                <tr>
                                    <td t-if="qr_code_url" style="width: 96px; padding-right: 8px;">
                                        <img t-att-src="qr_code_url" style="width: 88px; height: 88px;"/>
                                        <div class="upi"><i>UPI</i><span>SCAN TO PAY</span></div>
                                    </td>
                                    <td class="bank-lines">
                                        <div t-if="bank.get('name')">Name: <t t-out="bank['name']"/></div>
                                        <div t-if="bank.get('acc_number')">Account No.: <t t-out="bank['acc_number']"/></div>
                                        <div t-if="bank.get('ifsc')">IFSC code: <t t-out="bank['ifsc']"/></div>
                                        <div t-if="bank.get('holder')">Account Holder's Name: <t t-out="bank['holder']"/></div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td style="width: 33%;">
                            <div class="b" style="margin-bottom: 6px;">Terms and conditions</div>
                            <div t-if="not is_html_empty(o.narration)" t-field="o.narration"/>
                            <div t-else="">Thanks for doing business with us!</div>
                        </td>
                        <td style="width: 33%;" class="c">
                            <div>For: <t t-out="company.name"/></div>
                            <div class="b" style="margin-top: 60px;">Authorized Signatory</div>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_invoice_new">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="kadhan_tex_custom.report_invoice_new_document"/>
            </t>
        </t>
    </template>
</odoo>
